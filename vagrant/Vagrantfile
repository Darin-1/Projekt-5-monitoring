Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"

  # 1. KONTROLLNOD (Där du kör din Ansible-kod)
  config.vm.define "control" do |ctrl|
    ctrl.vm.hostname = "control"
    ctrl.vm.network "private_network", ip: "192.168.56.10"
  end

  # 2. ÖVERVAKNINGSSERVER (Prometheus + Grafana + Alertmanager)
  config.vm.define "monitor" do |mon|
    mon.vm.hostname = "monitor"
    mon.vm.network "private_network", ip: "192.168.56.11"
  end

  # 3. TJÄNSTESERVER 1 (Målnod för node_exporter)
  config.vm.define "server1" do |s1|
    s1.vm.hostname = "server1"
    s1.vm.network "private_network", ip: "192.168.56.12"
  end

  # 4. TJÄNSTESERVER 2 (Målnod för node_exporter)
  config.vm.define "server2" do |s2|
    s2.vm.hostname = "server2"
    s2.vm.network "private_network", ip: "192.168.56.13"
  end
end