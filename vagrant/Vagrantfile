# Keeps testing local and avoids cloud costs by running virtual machines.
Vagrant.configure("2") do |config|
  # "box" sets the base OS. "ubuntu/jammy64" boots Ubuntu 22.04.
  # Other boxes boot different systems. We need a stable base, so jammy64.
  config.vm.box = "ubuntu/jammy64"

  # "synced_folder" shares directories. It maps the host project root to the VM.
  # Without this, the VM cannot see our files. Ansible runs from the VM, so we share it.
  config.vm.define "control" do |ctrl|
    ctrl.vm.hostname = "control"
    ctrl.vm.network "private_network", ip: "192.168.56.10"
    ctrl.vm.synced_folder "../", "/project"
  end

  # "private_network" creates an isolated network. A static IP locks the address.
  # DHCP changes addresses dynamically. Ansible needs fixed addresses, so static.
  config.vm.define "monitor" do |mon|
    mon.vm.hostname = "monitor"
    mon.vm.network "private_network", ip: "192.168.56.11"
  end

  config.vm.define "server1" do |s1|
    s1.vm.hostname = "server1"
    s1.vm.network "private_network", ip: "192.168.56.12"
  end

  config.vm.define "server2" do |s2|
    s2.vm.hostname = "server2"
    s2.vm.network "private_network", ip: "192.168.56.13"
  end
end